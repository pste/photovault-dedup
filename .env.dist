API_URL=http://localhost:3000
API_TOKEN=

# Mount della share, in SOLA LETTURA: questo servizio non sposta e non cancella
# nulla. Le cancellazioni approvate le esegue photovault-scan.
MEDIA_ROOT=/data/photos

LOG_LEVEL=info
DEDUP_BATCH=200

# Il GC di Go non conosce i limiti cgroup: senza questo il pod cresce oltre il
# limite e viene OOMKillato a meta' lavoro.
GOMEMLIMIT=400MiB
